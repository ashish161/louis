# Louis runtime config — use LOUIS_* names so values apply at container runtime
# without rebuilding the Docker image. Legacy NUXT_* / NUXT_PUBLIC_* still work
# as a deprecated fallback (LOUIS_* wins when both are set). See README.md.

# Recommended — YouTube Data API v3 key (faster search + moderate safeSearch on typed search).
# Leave empty / commented out to search with bundled yt-dlp (no Google Cloud setup).
# Google Cloud: if asked "What data will you be accessing?", choose Public data (API key).
# LOUIS_YOUTUBE_API_KEY=

# Content filtering for typed YouTube search when using the Data API key above.
# none | moderate | strict — default moderate. No effect without LOUIS_YOUTUBE_API_KEY.
# LOUIS_YOUTUBE_SAFE_SEARCH=moderate

# Yoto public PKCE client ID (required — no silent fallback if empty).
# Paste Louis's bundled ID when your open-URL matches a redirect already on Louis's
# Yoto app (desktop 127.0.0.1:4010; HA default homeassistant.local:4000):
# LOUIS_YOTO_CLIENT_ID=PK00MDKCVwWvOG8o3px3qSl57FhfUZxm
# Desktop: prefer "Use default client" in setup / Settings → Advanced (same value).
# Any other origin (NAS IP, custom host, HTTPS): create your own public client at
# https://yoto.dev/get-started/start-here/ and paste that exact callback into
# Allowed Callback URLs (desktop :4010; Docker/HA :4000 or HTTPS hostname).
LOUIS_YOTO_CLIENT_ID=
# Optional — only for confidential server clients (must differ from client ID).
# Leave empty for public PKCE flow (recommended).
# LOUIS_YOTO_CLIENT_SECRET=

# Must match an Allowed Callback URL on the Yoto app for LOUIS_YOTO_CLIENT_ID.
# Unset = Louis uses the Host you actually opened (LAN IP, hostname, or localhost).
# Pin only when you want one stable origin (prefer a hostname over a DHCP IP).
# Other devices cannot use the Docker host's localhost — open Louis at the NAS/host URL.
# Desktop Electron always forces: http://127.0.0.1:4010/api/yoto/auth/callback
# LOUIS_YOTO_REDIRECT_URI=http://192.168.0.38:4000/api/yoto/auth/callback

# OAuth cookie Secure flag. Docker image defaults to false (LAN HTTP).
# Node-without-Docker: when unset, secure iff NODE_ENV=production.
# Set true behind HTTPS / reverse proxy / Nabu Casa.
# LOUIS_COOKIE_SECURE=false

# Optional: path to yt-dlp binary (Docker image includes it on PATH as `yt-dlp`)
# LOUIS_YTDLP_PATH=yt-dlp

# Optional — Spotify + spotDL (local playlist import via YouTube matches).
# Create an app at https://developer.spotify.com/dashboard
# Client ID + secret are enough to PASTE playlist URLs in Search (no Connect).
# Connect (list your playlists) needs a Redirect URI — many accounts only allow HTTPS:
#   https://127.0.0.1:4000/api/spotify/auth/callback  (+ mkcert — see docs/SPOTIFY.md)
#   https://YOUR.trycloudflare.com/api/spotify/auth/callback  (cloudflared tunnel)
# Spotify rejects localhost. Full guide: docs/SPOTIFY.md
# LOUIS_SPOTIFY_CLIENT_ID=
# LOUIS_SPOTIFY_CLIENT_SECRET=
# LOUIS_SPOTIFY_REDIRECT_URI=https://127.0.0.1:4000/api/spotify/auth/callback
# Local HTTPS dev (mkcert): LOUIS_DEV_TLS_KEY=./127.0.0.1-key.pem  LOUIS_DEV_TLS_CERT=./127.0.0.1.pem
# Optional: path to spotdl (pip install spotdl). Docker image installs spotdl when built.
# LOUIS_SPOTDL_PATH=spotdl
# Optional: YouTube-Music search attempts per song inside spotDL (its hardcoded default is 3).
# Lower = faster; 1 finds matches on the first search only. Rare unmatched songs may resolve on retry.
# LOUIS_SPOTDL_SEARCH_ATTEMPTS=1

# Optional: yt-dlp --js-runtimes value (default: node). Desktop Electron sets
# node:<shim> automatically so GUI launches work without system node on PATH.
# LOUIS_YTDLP_JS_RUNTIME=node

# Optional: Netscape cookies.txt for a throwaway YouTube account (yt-dlp --cookies).
# Downloads try anonymous first; cookies are used only after bot check / hard 403 / age-gate.
# Prefer a burner Google account. Never commit the file.
# See README.md and https://github.com/yt-dlp/yt-dlp/wiki/Extractors#exporting-youtube-cookies
# LOUIS_YTDLP_COOKIES_FILE=/data/secrets/youtube-cookies.txt

# Optional: temp directory for audio extraction cache (defaults to OS tmp/yoto-cards-audio)
# Docker / docker compose default: /data/audio
# LOUIS_AUDIO_WORK_DIR=/data/audio

# Optional: audio work-dir maintenance (defaults shown)
# LOUIS_AUDIO_JOB_MAX_AGE_MS=3600000
# LOUIS_AUDIO_CACHE_MAX_AGE_MS=1209600000
# LOUIS_AUDIO_CACHE_MAX_BYTES=5368709120

# ffmpeg is required for save (yt-dlp -x). Docker installs it; native installs need ffmpeg on PATH.

# Optional: debug API routes (off by default)
# LOUIS_ENABLE_DEBUG_ROUTES=true
